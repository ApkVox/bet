# Copia a .env y rellena

# API Key para noticias NBA y recomendaciones (local)
DEEPSEEK_API_KEY=sk-...

# --- Supabase (ver docs/SERVICIOS_Y_APIS.md, sección 3) ---
# Project Settings → API → Project URL (https://xxxxxxxx.supabase.co)
SUPABASE_URL=
# Project Settings → API → service_role (secret). NO uses la anon/publishable key.
SUPABASE_KEY=
# Project Settings → Database → Connect → Session pooler (config del admin/tema/promo):
# postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-N-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=
